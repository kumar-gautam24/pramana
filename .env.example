# Local development defaults. Copy to .env and change nothing unless a port collides.
# Nothing here is a production credential.
DB_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-password

# Which model backend the adjudication service builds: ollama | gemini | groq.
# ADR-0010 keeps the model a configuration choice -- swapping providers is these three
# variables and nothing else. A name outside the set fails at startup rather than
# falling back to a default nobody chose.
LLM_PROVIDER=ollama

# ollama: running on the host rather than in compose so it uses the Mac's GPU.
LLM_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:14b-instruct

# A hosted provider instead: uncomment one block. The keys are real credentials --
# they belong in .env, which is gitignored, and never in this file.
#
# LLM_PROVIDER=groq
# LLM_URL=https://api.groq.com
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=
#
# LLM_PROVIDER=gemini
# LLM_URL=https://generativelanguage.googleapis.com
# LLM_MODEL=gemini-2.5-pro
# GEMINI_API_KEY=
