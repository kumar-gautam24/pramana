# Local development defaults. Copy to .env and change nothing unless a port collides.
# Nothing here is a production credential.
DB_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-password

# Ollama, running on the host rather than in compose so it uses the Mac's GPU.
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:14b-instruct
