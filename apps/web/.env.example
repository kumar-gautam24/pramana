# The one backend address this application holds. There is deliberately no default in
# the code: a console that silently falls back to localhost would ship pointing at
# nothing in particular, and NEXT_PUBLIC_* values are inlined at build time, so the
# mistake would be baked into the image rather than reported at boot.
#
# Copy to .env.local for `npm run dev`. Under docker compose the value comes from the
# compose file's `web` block instead.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
